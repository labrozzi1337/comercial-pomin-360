# Supabase — Project Settings > API. Nunca exponha a service role no Vite.
POMIN360_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
POMIN360_SUPABASE_ANON_KEY=COLE_A_CHAVE_PUBLICA_AQUI
POMIN360_SUPABASE_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_KEY_AQUI

# Valores públicos usados pelo frontend Vite.
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=COLE_A_CHAVE_PUBLICA_AQUI

# Acesso de demonstração mostrado no guia do apresentador (v3). Preencha só no .env.local, nunca no git.
VITE_DEMO_EMAIL=
VITE_DEMO_SENHA=
VITE_DEMO_CFO_EMAIL=
VITE_DEMO_CFO_SENHA=
