{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "container"
    },
    "backend": {
      "root": "apps/backend",
      "framework": "nextjs"
    },
    "frontend": {
      "root": "apps/frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/perguntar",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/api/contratar",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
